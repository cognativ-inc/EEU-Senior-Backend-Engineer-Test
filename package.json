{
  "name": "eeu-senior-backend-engineer-test",
  "version": "1.0.0",
  "private": true,
  "description": "Pure TypeScript exercises for a senior backend engineer take-home exercise. No frameworks, no databases, no external runtime libraries.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "tsx --test 'exercises/*/*.test.ts'",
    "test:1": "tsx --test 'exercises/01-day-summary/*.test.ts'",
    "test:2": "tsx --test 'exercises/02-level-progress/*.test.ts'",
    "test:3": "tsx --test 'exercises/03-day-agenda/*.test.ts'",
    "test:4": "tsx --test 'exercises/04-reminder-plan/*.test.ts'",
    "test:5": "tsx --test 'exercises/05-subscription-renewal/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0"
  }
}
